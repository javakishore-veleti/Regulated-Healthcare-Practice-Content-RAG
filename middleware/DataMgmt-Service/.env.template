# DataMgmt-Service environment template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` in the same directory and uncomment / edit values.
# Values come from (priority order):
#   1. shell env vars exported in your terminal (highest priority)
#   2. this `.env` file
#   3. built-in defaults in common/settings.py (lowest priority)
#
# In cloud k8s deployments, prefer setting env vars from the deployment manifest
# (with secret references where applicable) and DO NOT ship a .env file in the
# image. The .env file is local-dev convenience only.

# ── Postgres connection ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=rhc_admin
DB_PASSWORD=rhc_local_dev
DB_NAME=rag_app
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=5

# ── OpenTelemetry ────────────────────────────────────────────────────────────
# OTEL_SERVICE_NAME=datamgmt-service
# Empty / unset → ConsoleSpanExporter; set this to ship to Jaeger / Tempo / etc.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# ── HTTP server ──────────────────────────────────────────────────────────────
# API_HOST=0.0.0.0
# API_PORT=8001

# ── Airflow integration ──────────────────────────────────────────────────────
# When set, /ingest triggers a DAG via Airflow REST. Unset → in-process stub.
AIRFLOW_BASE_URL=http://127.0.0.1:8080
# AIRFLOW_USERNAME=admin
# AIRFLOW_PASSWORD=admin
# AIRFLOW_POLL_INTERVAL_SECS=1.5
# AIRFLOW_TIMEOUT_SECS=180

# Browser-facing Airflow UI URL surfaced by /api/config to the SPAs. Falls
# back to AIRFLOW_BASE_URL when unset.
# AIRFLOW_UI_BASE=http://localhost:8080

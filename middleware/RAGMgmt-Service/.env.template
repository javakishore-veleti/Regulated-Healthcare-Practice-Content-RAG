# RAGMgmt-Service environment template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` in the same directory and uncomment / edit values.
# Values come from (priority order):
#   1. shell env vars exported in your terminal (highest priority)
#   2. this `.env` file
#   3. built-in defaults in common/settings.py (lowest priority)
#
# In cloud k8s deployments, prefer setting env vars from the deployment manifest
# (with secret references where applicable) and DO NOT ship a .env file in the
# image. The .env file is local-dev convenience only.

# ── Postgres (rag_app + rag_vectors share host/port/user/password) ──────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=rhc_admin
DB_PASSWORD=rhc_local_dev
DB_NAME=rag_app
# RAG_VECTORS_DB_NAME=rag_vectors
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=5

# ── OpenTelemetry ────────────────────────────────────────────────────────────
# OTEL_SERVICE_NAME=ragmgmt-service
# Empty / unset → ConsoleSpanExporter; set this to ship to Jaeger / Tempo / etc.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# ── HTTP server ──────────────────────────────────────────────────────────────
# API_HOST=0.0.0.0
# API_PORT=8002

# ── LLM drafter ──────────────────────────────────────────────────────────────
# Modes:
#   auto     — Anthropic when ANTHROPIC_API_KEY is set, else stub.
#   anthropic— direct Anthropic Messages API.
#   bedrock  — AWS Bedrock InvokeModel (requires [bedrock-drafter] extra +
#              BEDROCK_MODEL_ID set; credentials via standard AWS chain).
#   stub     — deterministic verbatim-citation composer (no LLM).
# LLM_DRAFTER=auto

# Anthropic API key. Three accepted forms:
#   1. Literal:        ANTHROPIC_API_KEY=sk-ant-api03-...
#   2. AWS Secrets:    ANTHROPIC_API_KEY=aws-sm://us-east-1/my-anthropic-key
#   3. Azure Key Vault: ANTHROPIC_API_KEY=azure-kv://my-vault/anthropic-key
#   4. GCP Secret Mgr: ANTHROPIC_API_KEY=gcp-sm://my-project/anthropic-key
# Cloud forms require the matching extra dep installed:
#   pip install '.[aws-secrets]'  /  '.[azure-secrets]'  /  '.[gcp-secrets]'
# ANTHROPIC_API_KEY=sk-ant-...

# Per the Excel architecture: Opus 4.7 for drafting, Haiku 4.5 for compliance.
# ANTHROPIC_MODEL=claude-opus-4-7
# ANTHROPIC_MAX_TOKENS=1500

# ── Bedrock drafter (LLM_DRAFTER=bedrock) ────────────────────────────────────
# Requires `pip install '.[bedrock-drafter]'`. Set BEDROCK_MODEL_ID to your
# cluster's Bedrock model identifier — typically an inference profile ID like
# `us.anthropic.claude-opus-4-7-...-v1:0`. Credentials come from the standard
# AWS chain (env vars, ~/.aws/credentials, IRSA, SSO).
# BEDROCK_MODEL_ID=
# BEDROCK_REGION=us-east-1

# ── Self-RAG regenerate loop ─────────────────────────────────────────────────
# How many times to regenerate when faithfulness fails. Stub drafter ignores
# this (deterministic — same input → same output).
# MAX_REGENERATE_ATTEMPTS=1

# ── Cross-encoder rerank ─────────────────────────────────────────────────────
# Backends:
#   token_overlap  — pure-stdlib RRF + Jaccard blend (default; no deps).
#   identity       — truncate-only (passthrough baseline).
#   cross_encoder  — learned reranker via sentence-transformers
#                    (cross-encoder/ms-marco-MiniLM-L-6-v2 by default).
#                    Requires `pip install '.[cross-encoder-rerank]'`
#                    (~2 GB transitive deps + ~90 MB model on first use).
#                    Falls back to token_overlap when the extra is missing.
# RAG_RERANKER_BACKEND=token_overlap
# RAG_RERANKER_ALPHA=0.5
# RAG_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Embedder backend ─────────────────────────────────────────────────────────
# stub                  — SHA-256 hash-based embedder, deterministic, no deps
#                          (default; not semantically meaningful).
# sentence_transformer  — real learned embedder via sentence-transformers
#                          (all-MiniLM-L6-v2 by default, 384-dim).
#                          Requires `pip install '.[real-embedder]'`.
#                          Falls back to stub when the dep / model is missing.
# WARNING: switching to sentence_transformer ALSO requires re-embedding the
# corpus — the DAG-side handler (handlers/embed_via_pgvector.py) needs the
# same model swap. Otherwise queries land in a different vector space than
# the corpus and similarity scores are meaningless.
# RAG_EMBEDDER_BACKEND=stub
# RAG_EMBEDDER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Retrieval backend ────────────────────────────────────────────────────────
# postgres                   — pgvector + tsvector in the rag_vectors DB (default).
# aws_opensearch_serverless  — AWS OpenSearch Serverless (Project A Excel Task 7).
#                              Requires `pip install '.[opensearch]'` AND an AOSS
#                              collection populated by your ingest pipeline.
#                              Auth via the standard AWS chain (env, IRSA, SSO).
#                              Falls back to postgres when the dep / endpoint is
#                              missing.
# RAG_RETRIEVAL_BACKEND=postgres
# AWS_OPENSEARCH_ENDPOINT=https://<id>.us-east-1.aoss.amazonaws.com
# AWS_OPENSEARCH_INDEX=rhc-child-chunks
# AWS_OPENSEARCH_REGION=us-east-1

# ── Langfuse observability (README's primary observability mechanism) ───────
# All four unset → gracefully disabled (no-op). Captures prompt/completion +
# retrieved-chunk metadata + faithfulness scores per /generate request, which
# the README calls out as load-bearing for a regulated-content use case.
# Requires the optional dep: `pip install '.[langfuse]'`.
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_ENVIRONMENT=local-dev
#
# Secret-manager refs accepted on LANGFUSE_*_KEY (same as ANTHROPIC_API_KEY):
#   LANGFUSE_SECRET_KEY=aws-sm://us-east-1/langfuse-secret
#   LANGFUSE_SECRET_KEY=azure-kv://my-vault/langfuse-secret
#   LANGFUSE_SECRET_KEY=gcp-sm://my-project/langfuse-secret

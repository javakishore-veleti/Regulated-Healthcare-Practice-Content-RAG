# RAGMgmt-Service environment template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` in the same directory and uncomment / edit values.
# Values come from (priority order):
#   1. shell env vars exported in your terminal (highest priority)
#   2. this `.env` file
#   3. built-in defaults in common/settings.py (lowest priority)
#
# In cloud k8s deployments, prefer setting env vars from the deployment manifest
# (with secret references where applicable) and DO NOT ship a .env file in the
# image. The .env file is local-dev convenience only.

# ── Postgres (rag_app + rag_vectors share host/port/user/password) ──────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=rhc_admin
DB_PASSWORD=rhc_local_dev
DB_NAME=rag_app
# RAG_VECTORS_DB_NAME=rag_vectors
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=5

# ── OpenTelemetry ────────────────────────────────────────────────────────────
# OTEL_SERVICE_NAME=ragmgmt-service
# Empty / unset → ConsoleSpanExporter; set this to ship to Jaeger / Tempo / etc.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# ── HTTP server ──────────────────────────────────────────────────────────────
# API_HOST=0.0.0.0
# API_PORT=8002

# ── LLM drafter ──────────────────────────────────────────────────────────────
# `auto` uses Anthropic when ANTHROPIC_API_KEY is set; falls back to stub.
# Force a specific drafter with `stub` or `anthropic`.
# LLM_DRAFTER=auto

# Anthropic API key. Three accepted forms:
#   1. Literal:        ANTHROPIC_API_KEY=sk-ant-api03-...
#   2. AWS Secrets:    ANTHROPIC_API_KEY=aws-sm://us-east-1/my-anthropic-key
#   3. Azure Key Vault: ANTHROPIC_API_KEY=azure-kv://my-vault/anthropic-key
#   4. GCP Secret Mgr: ANTHROPIC_API_KEY=gcp-sm://my-project/anthropic-key
# Cloud forms require the matching extra dep installed:
#   pip install '.[aws-secrets]'  /  '.[azure-secrets]'  /  '.[gcp-secrets]'
# ANTHROPIC_API_KEY=sk-ant-...

# Per the Excel architecture: Opus 4.7 for drafting, Haiku 4.5 for compliance.
# ANTHROPIC_MODEL=claude-opus-4-7
# ANTHROPIC_MAX_TOKENS=1500

# ── Self-RAG regenerate loop ─────────────────────────────────────────────────
# How many times to regenerate when faithfulness fails. Stub drafter ignores
# this (deterministic — same input → same output).
# MAX_REGENERATE_ATTEMPTS=1

  <diagram name="2. Three-corpora retrieval" id="three-corpora">
    <mxGraphModel dx="1280" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title-2" value="Three-corpora retrieval flow (POST /retrieve/three-corpora)" style="text;html=1;align=center;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1320" height="36" as="geometry" />
        </mxCell>

        <mxCell id="caption-2" value="Every draft is grounded in three corpora — regulator rules + clinical evidence + practice voice. Each corpus runs its own hybrid retrieval (BM25 + dense), fused with RRF, then reranked. The drafter receives a balanced mix instead of letting whichever corpus scores highest dominate." style="text;html=1;align=center;fontSize=11;fillColor=none;strokeColor=none;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="56" width="1280" height="50" as="geometry" />
        </mxCell>

        <mxCell id="query" value="Query&lt;br&gt;(topic from /generate)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="600" y="120" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="reg-corpus" value="REGULATOR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08434a;strokeColor=#08434a;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="240" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="evi-corpus" value="CLINICAL EVIDENCE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0089A7;strokeColor=#0089A7;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="240" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="voi-corpus" value="PRACTICE VOICE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0b04a;strokeColor=#f0b04a;fontColor=#000000;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="960" y="240" width="320" height="40" as="geometry" />
        </mxCell>

        <mxCell id="reg-bm25" value="BM25 (ts_rank_cd)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="120" y="320" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="reg-dense" value="Dense (pgvector ↔ cosine)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="320" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="reg-rrf" value="RRF fusion + rerank" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="120" y="400" width="320" height="40" as="geometry" />
        </mxCell>

        <mxCell id="evi-bm25" value="BM25 (ts_rank_cd)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="320" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="evi-dense" value="Dense (pgvector ↔ cosine)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="710" y="320" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="evi-rrf" value="RRF fusion + rerank" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="400" width="320" height="40" as="geometry" />
        </mxCell>

        <mxCell id="voi-bm25" value="BM25 (ts_rank_cd)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="320" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="voi-dense" value="Dense (pgvector ↔ cosine)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1130" y="320" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="voi-rrf" value="RRF fusion + rerank" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="400" width="320" height="40" as="geometry" />
        </mxCell>

        <mxCell id="reg-topk" value="top-K per corpus" style="text;html=1;align=center;fontSize=11;fontStyle=2;fillColor=none;strokeColor=none;" vertex="1" parent="1">

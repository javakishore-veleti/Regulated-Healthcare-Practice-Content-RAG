        <mxCell id="ret-os" value="OpenSearchRetrievalDao&#10;[opensearch]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF9900;strokeColor=#FF9900;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="900" y="260" width="220" height="40" as="geometry" />
        </mxCell>

        <mxCell id="iface-grd" value="IGuardrailsService&#10;RAG_GUARDRAILS_BACKEND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08434a;strokeColor=#08434a;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1160" y="120" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="g-regex" value="regex (30 rules)&#10;(default)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1160" y="200" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="g-bed" value="BedrockGuardrails&#10;[bedrock-guardrails]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF9900;strokeColor=#FF9900;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1160" y="260" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="g-lay" value="Layered (regex + bedrock)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1160" y="320" width="220" height="40" as="geometry" />
        </mxCell>

        <mxCell id="cli" value="rag_iface CLI&#10;python -m rag_iface.cli describe --cloud aws&#10;python -m rag_iface.cli generate --cloud local --topic ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="320" y="440" width="700" height="80" as="geometry" />
        </mxCell>

        <mxCell id="presets" value="cloud_presets&#10;local: stub + token_overlap + postgres + regex + auto&#10;aws:   bedrock + bedrock + cross_encoder + opensearch + layered" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafaf6;strokeColor=#666666;align=left;" vertex="1" parent="1">

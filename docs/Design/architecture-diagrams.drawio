  <diagram name="5. Ingestion DAG" id="ingestion-dag">
    <mxGraphModel dx="1280" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title-5" value="Ingestion pipeline — regulated_healthcare_dataset_ingest DAG" style="text;html=1;align=center;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1320" height="36" as="geometry" />
        </mxCell>

        <mxCell id="trigger" value="Trigger&#10;(admin portal OR POST /ingest)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="120" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="t1" value="resolve_destination&#10;&lt;font style='font-size:10px;'&gt;reads endpoints + system_datasets, builds path&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="120" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="t2" value="fetch_for_dataset_type&#10;&lt;font style='font-size:10px;'&gt;dispatches on dataset_type&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="120" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="t3" value="chunk_via_ragmgmt&#10;&lt;font style='font-size:10px;'&gt;HTML→markdown (preserves headings) → POST /chunk&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="120" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="t4" value="embed_to_vector_store&#10;&lt;font style='font-size:10px;'&gt;dispatches on RHC_DAG_VECTOR_STORE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="280" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="fr-list" value="&lt;b&gt;Fetcher Registry (dataset_type → handler)&lt;/b&gt;&#10;&#10;regulator_guidelines  → ahpra_advertising_rules_fetch&#10;pubmed                → ncbi_pubmed_fetch (about pages)&#10;pubmed_abstracts      → pubmed_abstracts_efetch (esearch + efetch)&#10;pmc                   → pmc_open_access_fetch (catalog)&#10;pmc_fulltext          → pmc_full_text_efetch (article XML)&#10;medical_transcriptions→ kaggle_medical_transcriptions_fetch&#10;common_crawl          → common_crawl_fetch&#10;&#10;All share _url_list_fetcher: retries, backoff, polite spacing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafaf6;strokeColor=#666666;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="100" y="240" width="500" height="200" as="geometry" />
        </mxCell>

        <mxCell id="vs-list" value="&lt;b&gt;Vector Store Backend (RHC_DAG_VECTOR_STORE)&lt;/b&gt;&#10;&#10;pgvector                  → embed_via_pgvector (default)&#10;aws_opensearch_serverless → embed_via_opensearch&#10;&#10;Both use the SAME embedder dispatch:&#10;  RHC_DAG_EMBEDDER ∈ {stub, aws_bedrock}&#10;  BEDROCK_EMBEDDING_MODEL_ID for the latter.&#10;&#10;Doc IDs are deterministic — re-runs upsert in place.&#10;Manifest's `embedder` field records the active backend." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafaf6;strokeColor=#666666;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="650" y="380" width="380" height="180" as="geometry" />
        </mxCell>

        <mxCell id="manifest" value="INGEST_MANIFEST.json&#10;&lt;font style='font-size:10px;'&gt;url_source, embedder, vector_store, total_rows_upserted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="500" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="de-1" style="endArrow=classic;html=1;" edge="1" parent="1" source="trigger" target="t1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de-2" style="endArrow=classic;html=1;" edge="1" parent="1" source="t1" target="t2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de-3" style="endArrow=classic;html=1;" edge="1" parent="1" source="t2" target="t3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de-4" style="endArrow=classic;html=1;" edge="1" parent="1" source="t3" target="t4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de-5" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1" source="t4" target="manifest">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="6. Plugin / Factory architecture" id="plugin-factory">
    <mxGraphModel dx="1280" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title-6" value="Plugin / Factory architecture — every load-bearing component is swappable" style="text;html=1;align=center;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1320" height="36" as="geometry" />
        </mxCell>

        <mxCell id="caption-6" value="Each Protocol has a build_*() factory that picks one implementation per env var. Factories never raise — misconfigured prod envs fall back to the local-dev default with a clear WARNING. Heavy backends are gated behind opt-in [extras] in pyproject.toml." style="text;html=1;align=center;fontSize=11;fillColor=none;strokeColor=none;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="56" width="1280" height="50" as="geometry" />
        </mxCell>

        <mxCell id="iface-drafter" value="IDrafter&#10;LLM_DRAFTER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08434a;strokeColor=#08434a;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d-stub" value="StubDrafter&#10;(default)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="d-anth" value="AnthropicDrafter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="170" y="200" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="d-bed" value="BedrockDrafter&#10;[bedrock-drafter]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF9900;strokeColor=#FF9900;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="260" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="iface-emb" value="IEmbedder&#10;RAG_EMBEDDER_BACKEND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08434a;strokeColor=#08434a;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="120" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-stub" value="StubEmbedder&#10;(default)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="200" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e-st" value="SentenceTransformer&#10;[real-embedder]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=#3F8624;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="200" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e-bed" value="BedrockEmbedder&#10;[bedrock-drafter]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF9900;strokeColor=#FF9900;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="260" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="iface-rer" value="IReranker&#10;RAG_RERANKER_BACKEND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08434a;strokeColor=#08434a;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="120" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r-id" value="IdentityReranker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="630" y="200" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r-tok" value="TokenOverlap&#10;(default)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="200" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r-ce" value="CrossEncoder&#10;[cross-encoder-rerank]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=#3F8624;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="260" width="180" height="40" as="geometry" />
        </mxCell>

        <mxCell id="iface-ret" value="IRetrievalDao&#10;RAG_RETRIEVAL_BACKEND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08434a;strokeColor=#08434a;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="120" width="220" height="50" as="geometry" />

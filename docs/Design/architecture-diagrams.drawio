  <diagram name="3. Generation pipeline" id="generation-pipeline">
    <mxGraphModel dx="1280" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title-3" value="Generation pipeline (POST /generate) — Self-RAG + Output Guardrails" style="text;html=1;align=center;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1320" height="36" as="geometry" />
        </mxCell>

        <mxCell id="user-req" value="POST /generate&#10;{topic, voice_profile, top_k_per_corpus}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="90" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="three-corpora-call" value="Three-corpora retrieval&#10;(see Tab 2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="190" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="reranker" value="Reranker&#10;TokenOverlap (default) | CrossEncoder (opt-in)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="280" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="drafter" value="Drafter&#10;Stub | Anthropic | Bedrock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="370" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="faith" value="FaithfulnessService&#10;score per sentence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="460" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="decision" value="score ≥ threshold?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="550" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="regen" value="Regenerate with hint&#10;(if drafter.supports_regeneration)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="555" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="guardrails" value="Output Guardrails&#10;regex (30-rule AHPRA) | Bedrock | layered" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="660" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="response" value="Response&#10;respCtxData {&#10;  draft_markdown,&#10;  citations[] (corpus_type, section_id),&#10;  retrieval_meta (corpora_present/missing),&#10;  faithfulness {score, passed},&#10;  guardrails {violations[], max_severity}&#10;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="540" y="760" width="360" height="160" as="geometry" />
        </mxCell>

        <mxCell id="langfuse-emit" value="Langfuse trace emit&#10;(privacy-by-default — rule_ids only,&#10;no violation_text or snippet content)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1000" y="770" width="280" height="80" as="geometry" />
        </mxCell>

        <mxCell id="g-e1" style="endArrow=classic;html=1;" edge="1" parent="1" source="user-req" target="three-corpora-call">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-e2" style="endArrow=classic;html=1;" edge="1" parent="1" source="three-corpora-call" target="reranker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

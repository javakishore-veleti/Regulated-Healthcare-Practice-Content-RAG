        <mxCell id="ret-pg" value="PostgresRetrievalDao&#10;(default)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="900" y="200" width="220" height="40" as="geometry" />
